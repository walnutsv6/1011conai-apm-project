{
  "id": "yakyuken",
  "label": "野球拳",
  "rule": "じゃんけんで1敗するごとに1段階脱ぐ。全段階を脱がせたらクリア。",
  "default_stage_count": 5,
  "stage_count_range": [5, 7],
  "framing": {"orientation": "portrait", "composition": "cowboy shot", "note": "じゃんけんの手が画面に入るよう腰〜太もも上"},
  "modes": ["transparent"],
  "exposed_expression": "blush",
  "expressions": {
    "normal": {"label": "通常", "tags": "gentle smile, blush"},
    "win":    {"label": "勝ち（嬉しい）", "tags": "happy, smile, open mouth"},
    "lose":   {"label": "負け（悔しい）", "tags": "pout, frustrated, blush"},
    "shy":    {"label": "照れ", "tags": "embarrassed, shy, blush"}
  },
  "optional_expressions": {
    "draw":   {"label": "あいこ（驚き）", "tags": "surprised, open mouth"}
  },
  "transition_expression": "shy",
  "special_poses": {
    "rock":     {"label": "グー", "tags": "standing, one arm extended forward, clenched fist, fist toward viewer", "expression": "determined, smile", "stages": "all"},
    "scissors": {"label": "チョキ", "tags": "standing, one arm extended forward, v sign toward viewer", "expression": "determined, smile", "stages": "all"},
    "paper":    {"label": "パー", "tags": "standing, one arm extended forward, open hand, palm toward viewer", "expression": "determined, smile", "stages": "all"}
  },
  "special_pose_note": "隠す構図（covered）では片手で隠し、もう片方の手でじゃんけんの手を出す。腕が干渉しやすいので試作で確認する。",
  "stage_template": [
    {"id": "dressed",  "label": "着衣", "class": "clothed", "role": "main"},
    {"id": "outer_tr", "label": "上着を脱ぐ途中", "class": "partial", "role": "transition"},
    {"id": "outeroff", "label": "上着なし", "class": "partial", "role": "main"},
    {"id": "under_tr", "label": "服を脱ぐ途中", "class": "underwear", "role": "transition"},
    {"id": "lingerie", "label": "下着", "class": "underwear", "role": "main"},
    {"id": "bra_tr",   "label": "ブラを外す途中", "class": "underwear", "role": "transition", "facing": "ask"},
    {"id": "topless",  "label": "トップレス", "class": "topless", "role": "main", "facing": "ask"},
    {"id": "panty_tr", "label": "ショーツを脱ぐ途中", "class": "topless", "role": "transition", "facing": "ask"},
    {"id": "nude",     "label": "ヌード", "class": "nude", "role": "main", "crotch": "both", "facing": "ask"}
  ],
  "events": {
    "player_win":  {"label": "勝ち（プレイヤー）", "advance": 1, "expression": "lose"},
    "player_lose": {"label": "負け（プレイヤー）", "advance": 0, "expression": "win"},
    "draw":        {"label": "あいこ", "advance": 0, "expression": "draw", "fallback_expression": "normal"},
    "call":        {"label": "じゃんけん…", "advance": 0, "special": ["rock", "scissors", "paper"], "random_special": true},
    "idle":        {"label": "待機", "advance": 0, "expression": "normal"},
    "after_strip": {"label": "脱いだ直後", "advance": 0, "expression": "shy"}
  },
  "oneshots": [
    {"id": "icon",   "kind": "icon",   "label": "キャラ選択アイコン", "from": {"stage": "dressed", "expression": "normal"}},
    {"id": "title",  "kind": "title",  "label": "タイトル・キービジュアル", "class": "clothed", "orientation": "landscape"},
    {"id": "reward", "kind": "reward", "label": "クリア時のご褒美CG", "class": "nude", "orientation": "portrait", "crotch": "both"}
  ]
}
